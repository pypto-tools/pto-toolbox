# Example only. Adapt account, paths and repository before installing.
[Unit]
Description=Collect redacted CI error excerpts
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=rerun
Group=rerun
WorkingDirectory=/opt/pr-rerun-service
Environment=HOME=/home/rerun
# Private file with PR_RERUN_DATABASE, App ID and App private key path.
# Optionally set PR_RERUN_STATS_DATABASE; use the same path in the API service.
EnvironmentFile=/home/rerun/.config/pr-rerun/service.env
UnsetEnvironment=PR_RERUN_CONFIG PR_RERUN_GITHUB_TOKEN PR_RERUN_GITHUB_TOKEN_FILE GH_TOKEN GITHUB_TOKEN GH_DEBUG PYTHONPATH PYTHONHOME
ExecStart=/opt/pr-rerun-service/.venv/bin/python -I -m pr_rerun.admin error-sync --repo owner/repository --days 30 --request-budget 100 --max-logs 100
# Exit 1 means partial progress, retained for the next scheduled sync.
SuccessExitStatus=1
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
